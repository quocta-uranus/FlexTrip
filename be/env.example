# App
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3001

# Database and Redis
DATABASE_URL="postgresql://flextrip:flextrip@localhost:5433/flextrip_db?schema=public"
REDIS_HOST=localhost
REDIS_PORT=6379

# Authentication
JWT_ACCESS_SECRET=<JWT_ACCESS_SECRET>
JWT_REFRESH_SECRET=<JWT_REFRESH_SECRET>
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
TWO_FACTOR_ENCRYPTION_KEY=<32_BYTE_BASE64_KEY>
TWO_FACTOR_CHALLENGE_SECRET=<TWO_FACTOR_CHALLENGE_SECRET>
KYC_ENCRYPTION_KEY=<32_BYTE_BASE64_KEY>
KYC_FINGERPRINT_SECRET=<KYC_FINGERPRINT_SECRET>

# Email
RESEND_API_KEY=<RESEND_API_KEY>
RESEND_FROM=FlexTrip <noreply@example.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<SMTP_USER>
SMTP_PASSWORD=<SMTP_PASSWORD>
SMTP_FROM=FlexTrip <noreply@example.com>
EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email
PASSWORD_RESET_URL=http://localhost:3000/reset-password

# AI chat and REVIEW-03 moderation
GROQ_API_KEY=<GROQ_API_KEY>
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REVIEW_MAX_COMPLETION_TOKENS=400
AI_SERVICE_URL=http://localhost:8000

# Supabase Storage
SUPABASE_URL=<SUPABASE_URL>
SUPABASE_PUBLISHABLE_KEY=<SUPABASE_PUBLISHABLE_KEY>
SUPABASE_SECRET_KEY=<SUPABASE_SECRET_KEY>

# Optional integrations
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:3000/payment/return
PAYOS_CANCEL_URL=http://localhost:3000/payment/cancel
PAYOS_TOPUP_RETURN_URL=http://localhost:3000/payment/topup/return
PAYOS_TOPUP_CANCEL_URL=http://localhost:3000/payment/topup/cancel
