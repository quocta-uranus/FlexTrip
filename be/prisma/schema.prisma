generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum Role {
  TRAVELER
  PROVIDER
  ADMIN
  STAFF
}

enum AuthProviderName {
  EMAIL
  GOOGLE
  FACEBOOK
  APPLE
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum KycDocumentType {
  NATIONAL_ID
  PASSPORT
  DRIVER_LICENSE
}

enum BookingStatus {
  PENDING_PAYMENT // vừa tạo, chưa thanh toán
  PENDING_APPROVAL // đã trả tiền, chờ provider duyệt
  CONFIRMED
  IN_PROGRESS // đang trong kỳ thuê
  COMPLETED
  CANCELLED
  DISPUTED // tranh chấp — listing bị lock
  REFUNDING
  REFUNDED
}

enum DeliveryMethod {
  PICKUP
  DELIVERY
}

enum CancelledBy {
  TRAVELER
  PROVIDER
  SYSTEM
}

enum ModifyRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ListingStatus {
  DRAFT
  ACTIVE
  INACTIVE
  SUSPENDED
  REMOVED
}

enum ContractStatus {
  PENDING
  TRAVELER_SIGNED
  SIGNED
  ACTIVE
  CLOSED
  DISPUTED
}

enum NotificationType {
  BOOKING
  PAYMENT
  MESSAGE
  SYSTEM
  REVIEW
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  FLAGGED
  REJECTED
}

enum ReviewSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
  UNKNOWN
}

enum ReviewModerationSource {
  RULE
  AI
  ADMIN
}

enum PaymentMethodType {
  CARD
  E_WALLET
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ShopCategory {
  CAMPING_TREKKING
  VEHICLE
  STAY
  EXPERIENCE
  OTHER
}

enum AdminDepartment {
  OPERATIONS
  TRUST_SAFETY
  FINANCE
  SUPPORT
  ENGINEERING
}

enum AdminLevel {
  L1
  L2
  L3
}

enum ListingFlagSource {
  USER
  SYSTEM
}

enum ListingFlagStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum DisputeType {
  REFUND_REQUEST
  PAYMENT_DISPUTE
  CANCELLATION_DISPUTE
  DAMAGE_CLAIM
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  PENDING_INFO
  ESCALATED
  RESOLVED
  REJECTED
}

enum DisputePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum StaffMediationStatus {
  OPEN
  RESOLVED
  ESCALATED
}

enum PayoutStatus {
  PENDING
  PAID
  ON_HOLD
}

enum AiChatRole {
  USER
  ASSISTANT
}

// ─── User & Auth ─────────────────────────────────────────────────────────────

model User {
  id                       String     @id @default(cuid())
  email                    String     @unique
  password                 String
  name                     String
  phone                    String?
  avatarUrl                String?
  status                   UserStatus @default(ACTIVE)
  emailVerifiedAt          DateTime?
  verificationRequestedAt  DateTime?
  passwordResetRequestedAt DateTime?
  isKycVerified            Boolean    @default(false)
  refreshToken             String?
  twoFactorEnabled         Boolean    @default(false)
  twoFactorSecret          String?
  twoFactorRecoveryCodes   String[]   @default([])
  suspendedAt              DateTime?
  suspensionReason         String?

  // traveler profile fields
  dateOfBirth       DateTime?
  gender            Gender?
  nationality       String?
  address           String?
  bio               String?   @db.Text
  emergencyContact  String?
  languages         String[]  @default(["vi"])
  preferredLanguage String?   @default("vi")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // auth relations
  roles                   UserRole[]
  verificationTokens      VerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  kycApplications         KycApplication[]     @relation("KycApplicant")
  reviewedKycApplications KycApplication[]     @relation("KycReviewer")
  authSessions            AuthSession[]

  // OAuth
  authProviders AuthProvider[]

  // profile relations
  travelPreferences  TravelPreference[]
  paymentMethods     PaymentMethod[]
  wallet             Wallet?
  providerProfile    ProviderProfile?
  adminProfile       AdminProfile?
  providerSetupToken ProviderSetupToken?

  // business domain
  listings            Listing[]
  bookings            Booking[]              @relation("TravelerBookings")
  cart                Cart?
  modifyRequests      BookingModifyRequest[]
  sentMessages        Message[]              @relation("SentMessages")
  notifications       Notification[]
  reviewsGiven        Review[]               @relation("ReviewsGiven")
  reviewsReceived     Review[]               @relation("ReviewsReceived")
  conversations       ConversationMember[]
  aiChatConversations AiChatConversation[]

  // admin
  staffProfile     StaffProfile?
  assignedBookings Booking[]             @relation("StaffAssignedBookings")
  reportedFlags    ListingFlag[]         @relation("FlagReporter")
  resolvedFlags    ListingFlag[]         @relation("FlagResolver")
  disputesOpened   Dispute[]             @relation("DisputeOpener")
  disputesHandled  Dispute[]             @relation("DisputeHandler")
  payouts          Payout[]              @relation("ProviderPayouts")
  payoutsCreated   Payout[]              @relation("PayoutCreator")
  configUpdates    SystemConfig[]        @relation("ConfigUpdater")
  auditLogs        AuditLog[]            @relation("AuditActor")
  staffRules       StaffAssignmentRule[] @relation("StaffRules")
  staffMediations  StaffMediation[]      @relation("StaffMediations")

  @@index([email])
}

model AuthSession {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  deviceName       String?
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model KycApplication {
  id                        String          @id @default(cuid())
  userId                    String
  legalName                 String
  documentType              KycDocumentType
  documentNumberEncrypted   String
  documentNumberFingerprint String          @unique
  documentNumberLast4       String
  documentFrontUrl          String
  documentBackUrl           String?
  selfieUrl                 String
  status                    KycStatus       @default(PENDING)
  rejectionReason           String?
  reviewedAt                DateTime?
  reviewedById              String?
  submittedAt               DateTime        @default(now())
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  applicant User  @relation("KycApplicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewer  User? @relation("KycReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([status, submittedAt])
  @@index([reviewedById])
}

model PasswordResetToken {
  id            String    @id @default(cuid())
  userId        String
  tokenHash     String    @unique
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  usedAt        DateTime?
  invalidatedAt DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserRole {
  userId String
  role   Role
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
}

model VerificationToken {
  id            String    @id @default(cuid())
  userId        String
  tokenHash     String    @unique
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  usedAt        DateTime?
  invalidatedAt DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthProvider {
  id          String           @id @default(cuid())
  userId      String
  provider    AuthProviderName
  providerUid String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUid])
  @@index([userId])
}

// ─── Listing ─────────────────────────────────────────────────────────────────

model Listing {
  id          String        @id @default(cuid())
  title       String
  description String        @db.Text
  price       Decimal       @db.Decimal(10, 2)
  currency    String        @default("VND")
  location    String
  latitude    Float?
  longitude   Float?
  imageUrls   String[]
  status      ListingStatus @default(DRAFT)
  category    String
  amenities   String[]
  providerId  String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // CAL-02: rental period config
  minRentalDays Int     @default(1)
  maxRentalDays Int?
  quantity      Int     @default(1)
  depositRate   Decimal @default(0.30) @db.Decimal(3, 2)

  // CONTR-02: điều khoản hợp đồng
  penaltyRules  Json?
  conditionNote String?  @db.Text

  // CONTR-05: giá trị cao
  marketValue   Decimal? @db.Decimal(12, 2)
  isHighValue   Boolean  @default(false)

  provider     User                  @relation(fields: [providerId], references: [id])
  bookings     Booking[]
  reviews      Review[]
  flags        ListingFlag[]
  availability ListingAvailability[]
  cartItems    CartItem[]

  @@index([providerId])
  @@index([status])
  @@index([location])
}

// ─── Booking ─────────────────────────────────────────────────────────────────

model Booking {
  id              String        @id @default(cuid())
  startDate       DateTime      @db.Date
  endDate         DateTime      @db.Date
  totalPrice      Decimal       @db.Decimal(10, 2)
  status          BookingStatus @default(PENDING_PAYMENT)
  notes           String?
  assignedStaffId String?
  travelerId      String
  listingId       String

  // BOOK-01
  quantity        Int            @default(1)
  depositAmount   Decimal        @default(0) @db.Decimal(10, 2)
  deliveryMethod  DeliveryMethod @default(PICKUP)
  deliveryAddress String?

  // BOOK-07: cancellation
  cancelledBy        CancelledBy?
  cancellationReason String?
  cancelledAt        DateTime?

  // BOOK-03: temporary hold
  holdExpiresAt DateTime?

  // BOOK-08: check-in/out (deferred, schema sẵn)
  checkedInAt       DateTime?
  checkedOutAt      DateTime?
  handoverCondition String?   @db.Text
  returnCondition   String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  traveler        User                   @relation("TravelerBookings", fields: [travelerId], references: [id])
  listing         Listing                @relation(fields: [listingId], references: [id])
  payment         Payment?
  contract        Contract?
  assignedStaff   User?                  @relation("StaffAssignedBookings", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  disputes        Dispute[]
  modifyRequests  BookingModifyRequest[]
  staffMediations StaffMediation[]
  review           Review?

  @@index([travelerId])
  @@index([listingId])
  @@index([status])
  @@index([assignedStaffId])
  @@index([startDate, endDate])
}

// ─── Availability ────────────────────────────────────────────────────────────

model ListingAvailability {
  id        String   @id @default(cuid())
  listingId String
  date      DateTime @db.Date
  isBlocked Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, date])
  @@index([listingId])
}

// ─── Cart ────────────────────────────────────────────────────────────────────

model Cart {
  id         String   @id @default(cuid())
  travelerId String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  traveler User       @relation(fields: [travelerId], references: [id], onDelete: Cascade)
  items    CartItem[]
}

model CartItem {
  id              String         @id @default(cuid())
  cartId          String
  listingId       String
  startDate       DateTime       @db.Date
  endDate         DateTime       @db.Date
  quantity        Int            @default(1)
  deliveryMethod  DeliveryMethod @default(PICKUP)
  deliveryAddress String?
  unitPrice       Decimal        @db.Decimal(10, 2)
  holdExpiresAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id])

  @@index([cartId])
  @@index([holdExpiresAt])
}

// ─── Booking Modify Request ───────────────────────────────────────────────────

model BookingModifyRequest {
  id            String              @id @default(cuid())
  bookingId     String
  requestedById String
  newStartDate  DateTime            @db.Date
  newEndDate    DateTime            @db.Date
  newQuantity   Int?
  reason        String?
  status        ModifyRequestStatus @default(PENDING)
  respondedAt   DateTime?
  createdAt     DateTime            @default(now())

  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  requestedBy User    @relation(fields: [requestedById], references: [id])

  @@index([bookingId])
}

// ─── Payment ─────────────────────────────────────────────────────────────────

model Payment {
  id              String        @id @default(cuid())
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("VND")
  platformFee     Decimal       @default(0) @db.Decimal(10, 2)
  status          PaymentStatus @default(PENDING)
  method          String
  transactionId   String?       @unique
  gatewayResponse Json?
  bookingId       String        @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([status])
}

// ─── Contract ────────────────────────────────────────────────────────────────

model Contract {
  id                   String         @id @default(cuid())
  bookingId            String         @unique
  templateType         String         @default("STANDARD")
  terms                String         @db.Text
  penaltyRules         Json?
  productConditionNote String?        @db.Text
  status               ContractStatus @default(PENDING)
  travelerSignedAt     DateTime?
  providerSignedAt     DateTime?
  checkInPhotos        String[]       @default([])
  checkOutPhotos       Json?
  idDocumentUrl        String?
  idDocumentType       String?
  insuranceOptIn       Boolean        @default(false)
  insuranceRef         String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])
}

// ─── Messaging ───────────────────────────────────────────────────────────────

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  ConversationMember[]
  messages Message[]
}

model ConversationMember {
  userId         String
  conversationId String
  joinedAt       DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@id([userId, conversationId])
}

model Message {
  id             String   @id @default(cuid())
  content        String   @db.Text
  isRead         Boolean  @default(false)
  senderId       String
  conversationId String
  createdAt      DateTime @default(now())

  sender       User         @relation("SentMessages", fields: [senderId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@index([senderId])
}

// ─── AI Chat ────────────────────────────────────────────────────────────────

model AiChatConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("Cuộc trò chuyện mới")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiChatMessage[]

  @@index([userId, updatedAt])
}

model AiChatMessage {
  id             String     @id @default(cuid())
  conversationId String
  role           AiChatRole
  content        String     @db.Text
  createdAt      DateTime   @default(now())

  conversation AiChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ─── Notification ────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false)
  userId    String
  data      Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
}

// ─── Review ──────────────────────────────────────────────────────────────────

model Review {
  id               String                  @id @default(cuid())
  rating           Int
  comment          String?                 @db.Text
  authorId         String
  targetId         String
  listingId        String?
  bookingId        String?                 @unique
  status           ReviewStatus            @default(PENDING)
  sentiment        ReviewSentiment         @default(UNKNOWN)
  spamScore        Int?
  toxicityScore    Int?
  suspicionScore   Int?
  moderationSource ReviewModerationSource?
  analysisReasons  Json?
  response         String?                 @db.Text
  respondedAt      DateTime?
  moderatedAt      DateTime?
  moderatedById    String?
  moderationNote   String?                 @db.Text
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  author  User     @relation("ReviewsGiven", fields: [authorId], references: [id])
  target  User     @relation("ReviewsReceived", fields: [targetId], references: [id])
  listing Listing? @relation(fields: [listingId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([listingId, status, createdAt])
  @@index([targetId, status])
  @@index([authorId, createdAt])
}

// ─── Profile ─────────────────────────────────────────────────────────────────

model TravelPreference {
  id        String   @id @default(cuid())
  userId    String
  tripType  String
  budgetMin Decimal? @db.Decimal(10, 2)
  budgetMax Decimal? @db.Decimal(10, 2)
  preferredCategories String[] @default([])
  budgetScope String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PaymentMethod {
  id        String            @id @default(cuid())
  userId    String
  type      PaymentMethodType
  token     String
  provider  String
  last4     String?
  isDefault Boolean           @default(false)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Wallet {
  walletId  String   @id @default(cuid())
  userId    String   @unique
  balance   Decimal  @default(0) @db.Decimal(14, 2)
  currency  String   @default("VND")
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@index([userId])
  @@map("wallets")
}

model WalletTransaction {
  id        String   @id @default(cuid())
  walletId  String
  type      String
  amount    Decimal  @db.Decimal(14, 2)
  refType   String?
  refId     String?
  note      String?
  createdAt DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [walletId], onDelete: Cascade)

  @@index([walletId])
  @@map("wallet_transactions")
}

// ─── Provider Profile ────────────────────────────────────────────────────────

model ProviderProfile {
  id            String       @id @default(cuid())
  userId        String       @unique
  shopName      String
  ownerName     String
  category      ShopCategory
  pickupAddress String
  pickupLat     Float?
  pickupLng     Float?
  responseHours String       @default("24 giờ")
  bio           String?      @db.Text
  highlights    String[]     @default([])

  itemsCount    Int     @default(0)
  rentalsCount  Int     @default(0)
  ratingAvg     Decimal @default(0) @db.Decimal(3, 2)
  reviewsCount  Int     @default(0)
  responseTimeH Int     @default(24)

  isLive       Boolean @default(true)
  payoutMethod String?
  bankAccount  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([isLive])
}

// ─── Admin Profile ───────────────────────────────────────────────────────────

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model ProviderApplication {
  id          String            @id @default(cuid())
  name        String
  phone       String
  email       String
  city        String
  categories  String[]
  description String?
  status      ApplicationStatus @default(PENDING)
  adminNote   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status])
  @@index([email])
}

model ProviderSetupToken {
  id        String    @id @default(cuid())
  userId    String    @unique
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminProfile {
  id         String          @id @default(cuid())
  userId     String          @unique
  employeeId String          @unique
  department AdminDepartment
  level      AdminLevel      @default(L1)
  bio        String?         @db.Text
  scopes     String[]        @default([])

  openTickets       Int @default(0)
  resolvedToday     Int @default(0)
  activeUsers       Int @default(0)
  pendingFlags      Int @default(0)
  configChangesWeek Int @default(0)

  twoFactorRequired Boolean   @default(true)
  lastPwRotateAt    DateTime?
  pwRotateDueAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([department])
  @@index([level])
}

// ─── Admin ───────────────────────────────────────────────────────────────────

model ListingFlag {
  id             String            @id @default(cuid())
  listingId      String
  reporterId     String?
  source         ListingFlagSource @default(USER)
  reason         String
  status         ListingFlagStatus @default(OPEN)
  resolvedById   String?
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime          @default(now())

  listing    Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporter   User?   @relation("FlagReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  resolvedBy User?   @relation("FlagResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([listingId, status])
  @@index([status, createdAt])
}

model Dispute {
  id              String          @id @default(cuid())
  bookingId       String
  openedById      String
  type            DisputeType
  priority        DisputePriority @default(MEDIUM)
  status          DisputeStatus   @default(OPEN)
  reason          String
  description     String?         @db.Text
  requestedAmount Decimal?        @db.Decimal(10, 2)
  resolution      String?         @db.Text
  refundAmount    Decimal?        @db.Decimal(10, 2)
  handledById     String?
  resolvedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  booking        Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  openedBy       User            @relation("DisputeOpener", fields: [openedById], references: [id])
  handledBy      User?           @relation("DisputeHandler", fields: [handledById], references: [id], onDelete: SetNull)
  staffMediation StaffMediation? @relation("MediationEscalation")

  @@index([status, createdAt])
  @@index([bookingId])
}

model Payout {
  id               String       @id @default(cuid())
  providerId       String
  periodStart      DateTime     @db.Date
  periodEnd        DateTime     @db.Date
  grossAmount      Decimal      @db.Decimal(14, 2)
  commissionAmount Decimal      @db.Decimal(14, 2)
  expectedNet      Decimal      @db.Decimal(14, 2)
  paymentCount     Int
  actualPaid       Decimal?     @db.Decimal(14, 2)
  // Stored (= actualPaid − expectedNet) because Prisma cannot compare two columns in a where.
  discrepancy      Decimal?     @db.Decimal(14, 2)
  transferRef      String?
  status           PayoutStatus @default(PENDING)
  note             String?
  paidAt           DateTime?
  createdById      String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  provider  User @relation("ProviderPayouts", fields: [providerId], references: [id])
  createdBy User @relation("PayoutCreator", fields: [createdById], references: [id])

  @@unique([providerId, periodStart, periodEnd])
  @@index([status])
}

model SystemConfig {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation("ConfigUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorRole  Role?
  action     String
  module     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([module, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

model StaffProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  employeeCode String   @unique
  phone        String?
  regions      String[] @default([])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StaffAssignmentRule {
  id        String   @id @default(cuid())
  name      String
  region    String
  staffId   String
  priority  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff User @relation("StaffRules", fields: [staffId], references: [id], onDelete: Cascade)

  @@index([isActive, priority])
}

model StaffMediation {
  id                 String               @id @default(cuid())
  bookingId          String
  staffId            String
  status             StaffMediationStatus @default(OPEN)
  issue              String               @db.Text
  travelerStatement  String?              @db.Text
  providerStatement  String?              @db.Text
  resolution         String?              @db.Text
  evidenceUrls       String[]             @default([])
  escalatedDisputeId String?              @unique
  resolvedAt         DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  booking          Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  staff            User     @relation("StaffMediations", fields: [staffId], references: [id], onDelete: Restrict)
  escalatedDispute Dispute? @relation("MediationEscalation", fields: [escalatedDisputeId], references: [id], onDelete: SetNull)

  @@index([staffId, status, createdAt])
  @@index([bookingId, createdAt])
}
