generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  TRAVELER
  PROVIDER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum KycDocumentType {
  NATIONAL_ID
  PASSPORT
  DRIVER_LICENSE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  REFUNDING
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ListingStatus {
  DRAFT
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ContractStatus {
  PENDING
  SIGNED
  ACTIVE
  CLOSED
  DISPUTED
}

enum NotificationType {
  BOOKING
  PAYMENT
  MESSAGE
  SYSTEM
  REVIEW
}

// ─── User & Auth ─────────────────────────────────────────────────────────────

model User {
  id                       String     @id @default(cuid())
  email                    String     @unique
  password                 String
  name                     String
  phone                    String?
  avatarUrl                String?
  status                   UserStatus @default(ACTIVE)
  emailVerifiedAt          DateTime?
  verificationRequestedAt  DateTime?
  passwordResetRequestedAt DateTime?
  isKycVerified            Boolean    @default(false)
  refreshToken             String?
  twoFactorEnabled         Boolean    @default(false)
  twoFactorSecret          String?
  twoFactorRecoveryCodes   String[]   @default([])
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt

  listings                Listing[]
  bookings                Booking[]            @relation("TravelerBookings")
  sentMessages            Message[]            @relation("SentMessages")
  notifications           Notification[]
  reviewsGiven            Review[]             @relation("ReviewsGiven")
  reviewsReceived         Review[]             @relation("ReviewsReceived")
  conversations           ConversationMember[]
  roles                   UserRole[]
  verificationTokens      VerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  kycApplications         KycApplication[]     @relation("KycApplicant")
  reviewedKycApplications KycApplication[]     @relation("KycReviewer")

  @@index([email])
}

model KycApplication {
  id                        String          @id @default(cuid())
  userId                    String
  legalName                 String
  documentType              KycDocumentType
  documentNumberEncrypted   String
  documentNumberFingerprint String          @unique
  documentNumberLast4       String
  documentFrontUrl          String
  documentBackUrl           String?
  selfieUrl                 String
  status                    KycStatus       @default(PENDING)
  rejectionReason           String?
  reviewedAt                DateTime?
  reviewedById              String?
  submittedAt               DateTime        @default(now())
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  applicant User  @relation("KycApplicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewer  User? @relation("KycReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([status, submittedAt])
  @@index([reviewedById])
}

model PasswordResetToken {
  id            String    @id @default(cuid())
  userId        String
  tokenHash     String    @unique
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  usedAt        DateTime?
  invalidatedAt DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserRole {
  userId String
  role   Role
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
}

model VerificationToken {
  id            String    @id @default(cuid())
  userId        String
  tokenHash     String    @unique
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  usedAt        DateTime?
  invalidatedAt DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Listing ─────────────────────────────────────────────────────────────────

model Listing {
  id          String        @id @default(cuid())
  title       String
  description String        @db.Text
  price       Decimal       @db.Decimal(10, 2)
  currency    String        @default("VND")
  location    String
  latitude    Float?
  longitude   Float?
  imageUrls   String[]
  status      ListingStatus @default(DRAFT)
  category    String
  amenities   String[]
  providerId  String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  provider User      @relation(fields: [providerId], references: [id])
  bookings Booking[]
  reviews  Review[]

  @@index([providerId])
  @@index([status])
  @@index([location])
}

// ─── Booking ─────────────────────────────────────────────────────────────────

model Booking {
  id         String        @id @default(cuid())
  startDate  DateTime
  endDate    DateTime
  totalPrice Decimal       @db.Decimal(10, 2)
  status     BookingStatus @default(PENDING)
  notes      String?
  travelerId String
  listingId  String
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  traveler User      @relation("TravelerBookings", fields: [travelerId], references: [id])
  listing  Listing   @relation(fields: [listingId], references: [id])
  payment  Payment?
  contract Contract?

  @@index([travelerId])
  @@index([listingId])
  @@index([status])
}

// ─── Payment ─────────────────────────────────────────────────────────────────

model Payment {
  id              String        @id @default(cuid())
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("VND")
  status          PaymentStatus @default(PENDING)
  method          String
  transactionId   String?       @unique
  gatewayResponse Json?
  bookingId       String        @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([status])
}

// ─── Contract ────────────────────────────────────────────────────────────────

model Contract {
  id            String         @id @default(cuid())
  terms         String         @db.Text
  status        ContractStatus @default(PENDING)
  signedAt      DateTime?
  checkInPhoto  String?
  checkOutPhoto String?
  bookingId     String         @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])
}

// ─── Messaging ───────────────────────────────────────────────────────────────

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  ConversationMember[]
  messages Message[]
}

model ConversationMember {
  userId         String
  conversationId String
  joinedAt       DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@id([userId, conversationId])
}

model Message {
  id             String   @id @default(cuid())
  content        String   @db.Text
  isRead         Boolean  @default(false)
  senderId       String
  conversationId String
  createdAt      DateTime @default(now())

  sender       User         @relation("SentMessages", fields: [senderId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@index([senderId])
}

// ─── Notification ────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false)
  userId    String
  data      Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
}

// ─── Review ──────────────────────────────────────────────────────────────────

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?  @db.Text
  authorId  String
  targetId  String
  listingId String?
  createdAt DateTime @default(now())

  author  User     @relation("ReviewsGiven", fields: [authorId], references: [id])
  target  User     @relation("ReviewsReceived", fields: [targetId], references: [id])
  listing Listing? @relation(fields: [listingId], references: [id])

  @@index([listingId])
  @@index([targetId])
}
