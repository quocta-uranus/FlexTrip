// FlexTrip — focus: AUTH & PROF groups (ERD lines 22-32)
// Profile entities (3 nhánh theo role):
//   - User                : thông tin cơ bản + traveler details
//   - ProviderProfile     : thông tin shop (Provider only)
//   - AdminProfile        : thông tin quản trị viên (Admin only)
// Hỗ trợ: Auth, Session, 2FA, KYC, TravelPreference, PaymentMethod, Wallet
// Bỏ: Listing/Booking/Review (chưa làm) — không cần cho phần này.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * ─────────────────────────────────────────────────────────────
 * ENUMS
 * ─────────────────────────────────────────────────────────────
 */

enum UserStatus {
  ACTIVE
  LOCKED
}

enum Role {
  TRAVELER
  PROVIDER
  ADMIN
}

enum AuthProviderName {
  EMAIL
  GOOGLE
  FACEBOOK
  APPLE
}

enum TwoFaMethod {
  TOTP
  SMS
  EMAIL
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentMethodType {
  CARD
  E_WALLET
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ShopCategory {
  CAMPING_TREKKING
  VEHICLE
  STAY
  EXPERIENCE
  OTHER
}

enum AdminDepartment {
  OPERATIONS
  TRUST_SAFETY
  FINANCE
  SUPPORT
  ENGINEERING
}

enum AdminLevel {
  L1
  L2
  L3
}

/**
 * ─────────────────────────────────────────────────────────────
 * USER (Traveler + identity root)
 * ─────────────────────────────────────────────────────────────
 */

model User {
  userId       String  @id @default(cuid())
  email        String  @unique
  phone        String?
  passwordHash String
  fullName     String
  avatarUrl    String?

  // ── traveler profile fields (chỉ dùng khi role = TRAVELER) ──
  dateOfBirth      DateTime?
  gender           Gender?
  nationality      String?
  address          String?
  bio              String?   @db.Text
  emergencyContact String?
  languages        String[]  @default(["vi"])

  // ── common ──
  preferredLanguage String?    @default("vi")
  status            UserStatus @default(ACTIVE)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  // ── relations ──
  roles             UserRole[]
  authProviders     AuthProvider[]
  sessions          UserSession[]
  twoFactor         TwoFactorAuth?
  kycVerifications  KycVerification[]
  travelPreferences TravelPreference[]
  paymentMethods    PaymentMethod[]
  wallet            Wallet?

  // Kyc reviewed by another User (Admin)
  kycReviewed KycVerification[] @relation("KycReviewer")

  // Profile theo role (1-1, optional — tuỳ user có role đó)
  providerProfile ProviderProfile?
  adminProfile    AdminProfile?

  @@index([email])
  @@index([status])
}

/**
 * ─────────────────────────────────────────────────────────────
 * USER ROLE (n-n với Role enum)
 * ─────────────────────────────────────────────────────────────
 */

model UserRole {
  id     String @id @default(cuid())
  userId String
  role   Role

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
}

/**
 * ─────────────────────────────────────────────────────────────
 * AUTH PROVIDER + SESSION + 2FA
 * ─────────────────────────────────────────────────────────────
 */

model AuthProvider {
  id          String           @id @default(cuid())
  userId      String
  provider    AuthProviderName
  providerUid String

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([provider, providerUid])
  @@index([userId])
}

model UserSession {
  id          String    @id @default(cuid())
  userId      String
  deviceInfo  String?
  ipAddress   String?
  refreshHash String?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([revokedAt])
}

model TwoFactorAuth {
  id        String      @id @default(cuid())
  userId    String      @unique
  isEnabled Boolean     @default(false)
  secretKey String?
  method    TwoFaMethod @default(TOTP)

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)
}

/**
 * ─────────────────────────────────────────────────────────────
 * KYC
 * ─────────────────────────────────────────────────────────────
 */

model KycVerification {
  id             String    @id @default(cuid())
  userId         String
  docType        String
  docNumber      String?
  docFrontUrl    String?
  docBackUrl     String?
  faceMatchScore Float?
  ocrResult      Json?
  status         KycStatus @default(PENDING)
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())

  user       User  @relation(fields: [userId], references: [userId], onDelete: Cascade)
  reviewedBy User? @relation("KycReviewer", fields: [reviewedById], references: [userId])

  @@index([userId])
  @@index([status])
}

/**
 * ─────────────────────────────────────────────────────────────
 * TRAVEL PREFERENCE (1-n theo user — lịch sử thay đổi)
 * ─────────────────────────────────────────────────────────────
 */

model TravelPreference {
  id        String   @id @default(cuid())
  userId    String
  tripType  String // leisure | business | trekking | mixed
  budgetMin Decimal? @db.Decimal(10, 2)
  budgetMax Decimal? @db.Decimal(10, 2)

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
}

/**
 * ─────────────────────────────────────────────────────────────
 * PAYMENT METHOD
 * ─────────────────────────────────────────────────────────────
 */

model PaymentMethod {
  id        String            @id @default(cuid())
  userId    String
  type      PaymentMethodType
  token     String
  provider  String
  last4     String?
  isDefault Boolean           @default(false)

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
}

/**
 * ─────────────────────────────────────────────────────────────
 * WALLET (PROF-03)
 * ─────────────────────────────────────────────────────────────
 */

model Wallet {
  walletId  String   @id @default(cuid())
  userId    String   @unique
  balance   Decimal  @default(0) @db.Decimal(14, 2)
  currency  String   @default("VND")
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [userId], onDelete: Cascade)
  transactions WalletTransaction[]

  @@index([userId])
  @@map("wallets")
}

model WalletTransaction {
  id        String   @id @default(cuid())
  walletId  String
  type      String // topup | payment | refund | payout | deposit_hold | deposit_release
  amount    Decimal  @db.Decimal(14, 2)
  refType   String?
  refId     String?
  note      String?
  createdAt DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [walletId], onDelete: Cascade)

  @@index([walletId])
  @@map("wallet_transactions")
}

/**
 * ─────────────────────────────────────────────────────────────
 * PROVIDER PROFILE (1-1 với User, chỉ khi role = PROVIDER)
 * Lưu riêng để không phình User + truy vấn nhanh theo shop.
 * ─────────────────────────────────────────────────────────────
 */

model ProviderProfile {
  id            String       @id @default(cuid())
  userId        String       @unique // FK -> User.userId (1-1)
  shopName      String // "Minhan Outdoor Gear"
  ownerName     String // "Nguyễn Minh"
  category      ShopCategory // enum
  pickupAddress String // "12 Bạch Đằng, Sơn Trà, Đà Nẵng"
  pickupLat     Float?
  pickupLng     Float?
  responseHours String       @default("24 giờ") // cam kết SLA
  bio           String?      @db.Text
  highlights    String[]     @default([]) // cam kết ngắn

  // ── KPI cached (denormalized — update qua job/event) ──
  itemsCount    Int     @default(0)
  rentalsCount  Int     @default(0)
  ratingAvg     Decimal @default(0) @db.Decimal(3, 2)
  reviewsCount  Int     @default(0)
  responseTimeH Int     @default(24)

  // ── status & payout ──
  isLive       Boolean @default(true) // đang nhận đơn?
  payoutMethod String? // "VCB ••• 4477"
  bankAccount  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([category])
  @@index([isLive])
}

/**
 * ─────────────────────────────────────────────────────────────
 * ADMIN PROFILE (1-1 với User, chỉ khi role = ADMIN)
 * Tách riêng để RBAC scope và audit riêng.
 * ─────────────────────────────────────────────────────────────
 */

model AdminProfile {
  id         String          @id @default(cuid())
  userId     String          @unique // FK -> User.userId (1-1)
  employeeId String          @unique // "EMP-AD-0042"
  department AdminDepartment // enum
  level      AdminLevel      @default(L1) // enum
  bio        String?         @db.Text

  // ── RBAC ──
  scopes String[] @default([]) // danh sách scope code

  // ── KPI cached ──
  openTickets       Int @default(0)
  resolvedToday     Int @default(0)
  activeUsers       Int @default(0)
  pendingFlags      Int @default(0)
  configChangesWeek Int @default(0)

  // ── security bắt buộc ──
  twoFactorRequired Boolean   @default(true)
  lastPwRotateAt    DateTime?
  pwRotateDueAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([department])
  @@index([level])
}
